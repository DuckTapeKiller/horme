{
  "name": "horme",
  "version": "4.0.7",
  "description": "AI-powered assistant with chat, right-click actions, vault-wide RAG, and an extensible skill system. Supports llama.cpp, Ollama, LM Studio, Claude, Gemini, OpenAI, Groq, OpenRouter, and Mistral.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run lint && node esbuild.config.mjs production",
    "lint": "eslint . --max-warnings=0 && stylelint styles.css --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --import tsx --require ./test/support/register.cjs --test test/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^0.14.0",
    "@types/node": "^16.11.6",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "latest",
    "prettier": "^3.3.2",
    "style-mod": "^4.1.3",
    "stylelint": "^18.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "tslib": "2.4.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    }
  },
  "dependencies": {
    "docx": "^9.6.1",
    "minimatch": "^11.0.9"
  }
}
